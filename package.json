{
  "name": "stremlist",
  "version": "1.12.0",
  "private": true,
  "description": "Stremlist - Sync your IMDb watchlist with Stremio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo-mathurin/imdb-watchlist-stremio.git"
  },
  "keywords": [
    "stremio",
    "addon",
    "imdb",
    "watchlist",
    "stremlist"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/leo-mathurin/imdb-watchlist-stremio/issues"
  },
  "homepage": "https://github.com/leo-mathurin/imdb-watchlist-stremio#readme",
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "turbo run dev:local",
    "dev:backend": "turbo run dev --filter=@stremlist/backend",
    "dev:frontend": "turbo run dev --filter=@stremlist/frontend",
    "dev:tailnet": "turbo run dev:tailnet",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:tooling": "node --test \".github/scripts/*.test.mjs\" \"tools/oxlint/anti-slop/rules/*.test.ts\"",
    "test:toolkit": "bun run --cwd apps/e2e test:toolkit",
    "test:toolkit:record": "bun run --cwd apps/e2e test:toolkit:record",
    "test:toolkit:replay": "bun run --cwd apps/e2e test:toolkit:replay",
    "lint": "turbo run lint:repo",
    "typecheck": "turbo run typecheck:repo",
    "lint:repo": "vp check",
    "typecheck:repo": "bun check",
    "fix": "vp check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "knip",
    "generate:types": "bun run --cwd packages/shared generate:types",
    "prepare": "vp config --no-agent"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^24.19.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.45.1",
    "portless": "0.15.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ],
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "catalog:"
  }
}
