{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_BACKEND_URL", "VERCEL_RELATED_PROJECTS"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORTLESS",
        "PORTLESS_*",
        "NODE_EXTRA_CA_CERTS",
        "VITE_BACKEND_URL",
        "DEV_BACKEND_URL",
        "VERCEL_RELATED_PROJECTS"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "format": {},
    "format:check": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev:tailnet": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORTLESS",
        "PORTLESS_*",
        "NODE_EXTRA_CA_CERTS",
        "VITE_BACKEND_URL",
        "DEV_BACKEND_URL",
        "VERCEL_RELATED_PROJECTS"
      ]
    }
  }
}
