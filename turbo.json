{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_BACKEND_URL", "VERCEL_RELATED_PROJECTS"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORTLESS",
        "PORTLESS_*",
        "NODE_EXTRA_CA_CERTS",
        "VITE_BACKEND_URL",
        "DEV_BACKEND_URL",
        "VERCEL_RELATED_PROJECTS"
      ]
    },
    "dev:local": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DOCKER_*",
        "PORTLESS",
        "PORTLESS_*",
        "NODE_EXTRA_CA_CERTS",
        "VITE_BACKEND_URL",
        "DEV_BACKEND_URL",
        "VERCEL_RELATED_PROJECTS"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false
    },
    "dev:tailnet": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORTLESS",
        "PORTLESS_*",
        "NODE_EXTRA_CA_CERTS",
        "VITE_BACKEND_URL",
        "DEV_BACKEND_URL",
        "VERCEL_RELATED_PROJECTS"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["@stremlist/backend#build"],
      "cache": false
    },
    "//#typecheck:repo": {
      "dependsOn": ["@stremlist/backend#build"],
      "cache": false
    }
  }
}
