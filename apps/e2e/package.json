{
  "name": "@stremlist/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "bun preflight.ts && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:toolkit": "e2e run",
    "test:toolkit:record": "e2e run --tag agent",
    "test:toolkit:replay": "CI=1 E2E_OAUTH_CREDENTIALS='{}' e2e run --strict-cache"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@e2e-dev/web": "^0.12.0",
    "@playwright/test": "^1.62.1",
    "@stremlist/backend": "workspace:*",
    "@stremlist/eslint-config": "workspace:*",
    "@stremlist/frontend": "workspace:*",
    "@stremlist/shared": "workspace:*",
    "@supabase/supabase-js": "^2.95.3",
    "@types/node": "^20.11.17",
    "ai": "^7",
    "e2e": "^0.17.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.8.3"
  }
}
