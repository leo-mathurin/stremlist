    "@stremlist/frontend": "workspace:*",
    "@stremlist/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^24.19.2",
    "ai": "^7.0.172",
    "e2e": "0.17.0",
    "msw": "^2.15.0",
    "zod": "^4.6.7"
  }
