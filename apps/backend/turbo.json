{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID"
      ],
      "passThroughEnv": [
        "BETTERSTACK_HEARTBEAT_URL",
        "BETTERSTACK_HEARTBEAT_URL_IMDB",
        "BETTERSTACK_HEARTBEAT_URL_LETTERBOXD",
        "BETTERSTACK_HEARTBEAT_URL_JUSTWATCH",
        "BETTERSTACK_HEARTBEAT_URL_SENSCRITIQUE",
        "MONITOR_IMDB_USER_ID",
        "MONITOR_LETTERBOXD_REF",
        "MONITOR_JUSTWATCH_REF",
        "MONITOR_SENSCRITIQUE_REF",
        "LETTERBOXD_MAX_RPS",
        "CRON_SECRET"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "!PORTLESS_TAILSCALE",
        "!PORTLESS_FUNNEL",
        "!PORTLESS_NGROK"
      ]
    },
    "dev:tailnet": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "!PORTLESS_TAILSCALE",
        "!PORTLESS_FUNNEL",
        "!PORTLESS_NGROK"
      ]
    },
    "dev:local": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "!PORTLESS_TAILSCALE",
        "!PORTLESS_FUNNEL",
        "!PORTLESS_NGROK"
      ]
    }
  }
}
