{
  "name": "@stremlist/backend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "portless",
    "dev:local": "bun scripts/dev-local.mjs",
    "dev:ready": "bun scripts/wait-for-ready.mjs",
    "build": "vp pack && tsc --emitDeclarationOnly",
    "start": "bun dist/index.js",
    "test": "vp test run --exclude '**/*.stress.test.ts'",
    "test:stress": "vp test run src/services/__tests__/imdb-scraper.stress.test.ts",
    "stress:load": "bun stress/run.ts",
    "stress:letterboxd-gate": "bun stress/letterboxd-gate.ts",
    "cleanup:invalid-users": "bun src/scripts/cleanup-invalid-users.ts",
    "dev:app": "bun --watch --env-file=.env src/dev.ts",
    "dev:tailnet": "portless"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@hono/zod-validator": "^0.9.1",
    "@stremlist/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/functions": "^3.11.2",
    "@vercel/related-projects": "^1.1.1",
    "cheerio": "1.2.0",
    "hono": "^4.13.18",
    "resend": "^6.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.19",
    "@types/node": "^24.19.2",
    "dotenv": "^17.4.2",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "portless": {
    "name": "api.stremlist",
    "script": "dev:app",
    "proxy": true
  }
}
